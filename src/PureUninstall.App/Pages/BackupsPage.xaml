<Page
    x:Class="PureUninstall.App.Pages.BackupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="备份还原" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="卸载清理前自动备份的注册表项和文件，删错了可以一键还原"
                       Opacity="0.7" VerticalAlignment="Center" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="BackupsList" Margin="0,14,0,0"
                  ItemsSource="{x:Bind Backups, Mode=OneWay}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Opacity="0.6">
                                <Run Text="{Binding CreatedAtText}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Items.Count, Mode=OneWay}" />
                                <Run Text=" 项 · " />
                                <Run Text="{Binding SizeText}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="还原" FontSize="12" Click="OnRestoreClick" Tag="{Binding}" />
                            <Button Content="删除" FontSize="12" Click="OnDeleteClick" Tag="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,10,0,0" Opacity="0.75" TextWrapping="Wrap" />
    </Grid>
</Page>
