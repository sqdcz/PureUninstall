<Page
    x:Class="PureUninstall.App.Pages.BatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="批量卸载" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="QueueCountText" Text="队列为空" Opacity="0.7" VerticalAlignment="Center" />
        </StackPanel>

        <!-- queue + options -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- queue -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="卸载队列（按顺序执行）" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListView Grid.Row="1" x:Name="QueueList" ItemsSource="{x:Bind Queue, Mode=OneWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding KindText}" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="移除" FontSize="12"
                                        Click="OnRemoveFromQueueClick" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- options + results -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8">
                <TextBlock Text="选项" FontWeight="SemiBold" />
                <CheckBox x:Name="QuietBox" Content="安静卸载（无人值守）" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                <CheckBox x:Name="AggressiveBox" Content="深度扫描（更慢更全）" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                <CheckBox x:Name="BackupBox" Content="删除前自动备份" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                <CheckBox x:Name="ForceModeBox" Content="强制删除模式（跳过卸载程序）" />
                <TextBlock Text="执行结果" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ListView x:Name="ResultsList" MaxHeight="280" ItemsSource="{x:Bind Results, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding App.DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Note}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>

        <!-- progress + run -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ProgressBar x:Name="BatchProgressBar" Maximum="100" />
                <TextBlock x:Name="BatchStatusText" Text="就绪" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="清空队列" Click="OnClearQueueClick" />
                <Button x:Name="RunBatchButton" Content="开始批量卸载" Style="{StaticResource AccentButtonStyle}"
                        Click="OnRunBatchClick" IsEnabled="False" />
                <Button x:Name="CancelBatchButton" Content="取消" Click="OnCancelBatchClick" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
