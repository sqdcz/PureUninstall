<Page
    x:Class="PureUninstall.App.Pages.PersistencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="持久化检测" FontSize="22" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,6,20,0"
                           Text="把所有「开机就会自己跑起来」的位置摊开：启动项、启动目录、服务、计划任务、登录劫持、调试器劫持、DLL 注入、WMI 订阅。每一项都给出可疑依据，删不删由你判断。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                <Button x:Name="ScanButton" Click="OnScanClick" Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.Name="开始检测">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="开始检测" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 统计 -->
        <StackPanel x:Name="StatsBar" Grid.Row="1" Orientation="Horizontal" Spacing="10"
                    Visibility="Collapsed">
            <Border Background="#FDE7E9" CornerRadius="6" Padding="12,6" BorderBrush="#E81123" BorderThickness="0,0,0,3">
                <TextBlock>
                    <Run Text="高风险 " FontSize="12" />
                    <Run x:Name="HighCount" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#C42B1C" />
                </TextBlock>
            </Border>
            <Border Background="#FFF4E5" CornerRadius="6" Padding="12,6" BorderBrush="#F7A100" BorderThickness="0,0,0,3">
                <TextBlock>
                    <Run Text="中风险 " FontSize="12" />
                    <Run x:Name="MediumCount" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#9D5D00" />
                </TextBlock>
            </Border>
            <Border Background="#F1F3F6" CornerRadius="6" Padding="12,6">
                <TextBlock>
                    <Run Text="低风险 " FontSize="12" />
                    <Run x:Name="LowCount" Text="0" FontSize="15" FontWeight="SemiBold" />
                </TextBlock>
            </Border>
            <Border Background="#EEF3F9" CornerRadius="6" Padding="12,6">
                <TextBlock>
                    <Run Text="系统组件 " FontSize="12" />
                    <Run x:Name="SystemCount" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" />
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- 筛选 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <ComboBox x:Name="FilterBox" Width="230" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="只看需要关注的（高 + 中）" IsSelected="True" />
                <ComboBoxItem Content="只看高风险" />
                <ComboBoxItem Content="全部（含系统组件）" />
            </ComboBox>
            <CheckBox x:Name="SelectAllBox" Content="全选当前列表" IsChecked="False"
                      Checked="OnSelectAllChanged" Unchecked="OnSelectAllChanged" />
            <Button Content="导入特征库" Click="OnImportSignatureClick"
                    AutomationProperties.Name="导入特征库"
                    ToolTipService.ToolTip="导入 JSON 格式的特征文件，命中的项会被标记并提升风险等级" />
            <Button Content="导出特征模板" Click="OnExportTemplateClick"
                    AutomationProperties.Name="导出特征模板" />
            <TextBlock x:Name="SignatureInfo" VerticalAlignment="Center" FontSize="11"
                       Opacity="0.55" Margin="4,0,0,0" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
        </StackPanel>

        <!-- 列表 -->
        <Grid Grid.Row="3">
            <ListView x:Name="ItemList" SelectionMode="Multiple" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="2,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{Binding RiskBg}" CornerRadius="4" Padding="8,2"
                                    VerticalAlignment="Top" MinWidth="40" Margin="0,2,0,0">
                                <TextBlock Text="{Binding RiskText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding RiskFg}" HorizontalAlignment="Center" />
                            </Border>

                            <Border Grid.Column="1" Background="#F1F3F6" CornerRadius="4" Padding="7,2"
                                    VerticalAlignment="Top" MinWidth="58" Margin="0,2,0,0">
                                <TextBlock Text="{Binding KindText}" FontSize="11" HorizontalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Command}" FontSize="11" Opacity="0.62"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                <TextBlock FontSize="10" Opacity="0.42" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SignerText}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding ReasonText}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="10">
                <FontIcon Glyph="&#xE9D9;" FontSize="36" Opacity="0.25" />
                <TextBlock Text="还没开始检测" Opacity="0.6" />
                <TextBlock FontSize="12" Opacity="0.45" TextAlignment="Center" MaxWidth="440"
                           Text="点右上角「开始检测」，扫描一遍所有自启动位置，大约几秒。" />
            </StackPanel>
        </Grid>

        <!-- 底部操作 -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CleanButton" Content="删除选中项" IsEnabled="False" Click="OnCleanClick"
                        AutomationProperties.Name="删除选中项" />
                <Button x:Name="ExportButton" Content="导出报告" IsEnabled="False" Click="OnExportClick"
                        AutomationProperties.Name="导出报告" />
                <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="11" Opacity="0.45"
                           Margin="8,0,0,0"
                           Text="删除前会自动备份；WMI 订阅结构复杂，只展示不代删。" />
            </StackPanel>
            <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Opacity="0.6" />
        </Grid>
    </Grid>
</Page>
