<Page
    x:Class="PureUninstall.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索名称或厂商…" TextChanged="OnSearchChanged" />
            <ComboBox Grid.Column="1" x:Name="FilterCombo" Margin="8,0,0,0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="全部类型" IsSelected="True" />
                <ComboBoxItem Content="传统安装" />
                <ComboBoxItem Content="MSI 安装" />
                <ComboBoxItem Content="应用商店" />
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="SortCombo" Margin="8,0,0,0" SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="按名称" IsSelected="True" />
                <ComboBoxItem Content="按大小" />
                <ComboBoxItem Content="按安装日期" />
            </ComboBox>
            <Button Grid.Column="3" HorizontalAlignment="Right" Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- list + loading overlay -->
        <Grid Grid.Row="1">
            <ListView x:Name="AppsList" SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                      ItemsSource="{x:Bind Apps, Mode=OneWay}" DoubleTapped="OnOpenWizard">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="34" Height="34" Source="{Binding IconImage}" />
                            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KindText}" FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid x:Name="LoadingOverlay" Background="#B0FFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock x:Name="LoadingText" Text="正在读取已安装软件…" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- bottom bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="UninstallButton" Click="OnUninstallClick" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="卸载" />
                    </StackPanel>
                </Button>
                <Button x:Name="BatchAddButton" Click="OnAddToBatchClick" IsEnabled="False">加入批量队列</Button>
                <Button x:Name="ForceDeleteButton" Click="OnForceDeleteClick" IsEnabled="False">强制删除</Button>
                <Button x:Name="DetailsButton" Click="OnDetailsClick" IsEnabled="False">详情</Button>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="SelectionText" VerticalAlignment="Center" Opacity="0.7" Text="共 0 个软件" />
        </Grid>
    </Grid>
</Page>
