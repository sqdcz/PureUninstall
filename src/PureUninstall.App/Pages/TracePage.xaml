<Page
    x:Class="PureUninstall.App.Pages.TracePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="安装追踪" FontSize="22" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,6,20,0"
                           Text="装软件之前拍一份系统快照，装完再拍一次；两次的差集就是它到底往系统里塞了什么。卸载时连这些一起清掉，适合没有卸载程序、或卸载程序不干活的软件。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="StartButton" Click="OnStartClick" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="开始追踪">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="开始追踪" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 进行中的追踪 -->
        <Border x:Name="ActiveBar" Grid.Row="1" Visibility="Collapsed"
                Background="#E8F2FC" BorderBrush="#0F6CBD" BorderThickness="1"
                CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ActiveTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ActiveHint" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                               Text="现在去安装软件。装完（包括重启之后）回来点「结束追踪」，系统会比对两次快照。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                    <Button x:Name="FinishButton" Content="结束追踪" Click="OnFinishClick" />
                    <Button x:Name="CancelButton" Content="放弃" Click="OnCancelClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左边历史，右边结果 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 历史 -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="追踪记录" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="HistoryCount" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.6" />
                </Grid>
                <ListView x:Name="SessionList" Grid.Row="1" Margin="0,8,0,0"
                          SelectionMode="Single" SelectionChanged="OnSessionSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="2,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE81C;" FontSize="16" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SummaryText}" FontSize="12" Opacity="0.62"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding StartedText}" FontSize="11" Opacity="0.45"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 结果 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="选择一个追踪记录查看结果" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailSummary" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.65" />
                </Grid>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE9D9;" FontSize="36" Opacity="0.25" />
                    <TextBlock Text="还没有追踪记录" Opacity="0.6" />
                    <TextBlock FontSize="12" Opacity="0.45" TextAlignment="Center" MaxWidth="420"
                               Text="点右上角「开始追踪」，装完软件回来结束追踪，就能看到它动了哪些地方。" />
                </StackPanel>

                <ListView x:Name="ItemList" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed"
                          SelectionMode="Multiple">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="2,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#E8F2FC" CornerRadius="4" Padding="7,2"
                                        VerticalAlignment="Center" MinWidth="56">
                                    <TextBlock Text="{Binding KindText}" FontSize="11"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button x:Name="CleanButton" Content="删除选中项" IsEnabled="False"
                            Click="OnCleanClick" />
                    <Button x:Name="ExportButton" Content="导出清单" IsEnabled="False"
                            Click="OnExportClick" />
                    <Button x:Name="DeleteTraceButton" Content="删除这条记录" IsEnabled="False"
                            Click="OnDeleteTraceClick" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                               Opacity="0.6" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
