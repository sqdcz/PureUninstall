<Page
    x:Class="PureUninstall.App.Pages.UninstallWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- content: 4 stacked states -->
        <Grid Grid.Row="1" Margin="0,20,0,0">

            <!-- state 1: running the uninstaller -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressRing IsActive="True" Width="40" Height="40" />
                <TextBlock x:Name="RunningStatus" Text="正在卸载…" />
                <Button Content="取消" Click="OnCancelClick" />
            </StackPanel>

            <!-- state 2: residual checklist -->
            <Grid x:Name="ChecklistPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="ChecklistSummary" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="全选" Click="OnSelectAllClick" FontSize="12" />
                    <Button Content="全不选" Click="OnSelectNoneClick" FontSize="12" />
                </StackPanel>
                <ListView Grid.Row="1" x:Name="ResidualList" Margin="0,10,0,0"
                          ItemsSource="{x:Bind Residuals, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding KindText}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Detail}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding SizeText}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                    <Button Content="开始清理" Style="{StaticResource AccentButtonStyle}" Click="OnCleanClick" />
                    <Button Content="跳过清理" Click="OnSkipClick" />
                </StackPanel>
            </Grid>

            <!-- state 3: cleaning -->
            <StackPanel x:Name="CleaningPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressRing IsActive="True" Width="40" Height="40" />
                <TextBlock x:Name="CleaningStatus" Text="备份中…" />
            </StackPanel>

            <!-- state 4: done -->
            <StackPanel x:Name="DonePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="#0F766E" />
                <TextBlock x:Name="DoneSummary" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" />
                <TextBlock x:Name="DoneBackup" Opacity="0.7" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="560" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="完成" Style="{StaticResource AccentButtonStyle}" Click="OnDoneClick" />
                    <Button x:Name="OpenBackupDirButton" Content="打开备份目录" Click="OnOpenBackupDirClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
