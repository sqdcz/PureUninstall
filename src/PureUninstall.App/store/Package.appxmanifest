<?xml version="1.0" encoding="utf-8"?>
<!--
  纯净卸载 MSIX 打包清单（微软商店版）
  ⚠️ Publisher 当前是占位符。正式提交前必须替换为 Partner Center 预留应用名后
  给出的 Publisher CN（形如 CN=3C8B9F2A-1234-4E5F-9ABC-0123456789AB），
  否则商店会拒绝（标识不匹配）。替换后需用匹配该 CN 的证书签名。
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3" xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" IgnorableNamespaces="uap uap3 rescap">
  <Identity Name="31096ADE.453098C59DDDA" Publisher="CN=EDFD9F3C-211F-42CA-B6B9-3A9E55BEEEBC" Version="0.1.2.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>纯净卸载</DisplayName>
    <PublisherDisplayName>衰气的船只</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>深度卸载工具：卸载后自动清理文件、注册表、计划任务、服务、启动项、防火墙规则、WMI 七类残留，支持批量卸载、强制删除与删除前备份还原。</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19045.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.8" MinVersion="8000.994.2142.0" />
  </Dependencies>
  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="PureUninstall.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="纯净卸载" Description="深度卸载工具" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="allowElevation" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>